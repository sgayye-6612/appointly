# Copy this file to ".env" and fill in your values. Never share or commit .env.

# PostgreSQL connection. Leave empty to use a local SQLite file (server/appointly.db) instead.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/appointly

# Any long random string (32+ characters). Used to sign login tokens.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters

# Load the 25 demo businesses and sample bookings the first time (true/false)
SEED_DEMO_DATA=true

# Demo logins (change them before showing this to real users)
DEMO_OTP=123456
DEMO_BUSINESS_PASSWORD=Appointly@123
ADMIN_EMAIL=admin@appointly.demo
ADMIN_PASSWORD=Appointly@Admin
DEMO_LOGINS=true
